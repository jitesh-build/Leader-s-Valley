# ---- Dependencies ----
node_modules/
**/node_modules/

# ---- Environment / secrets ----
.env
.env.local
.env.*.local
**/.env
**/.env.local
**/.env.*.local
# .env.example files ARE meant to be committed - explicitly un-ignore them
!.env.example
!**/.env.example

# ---- Build output ----
dist/
build/
**/dist/
**/build/

# ---- Vite ----
.vite/
**/.vite/

# ---- TypeScript ----
*.tsbuildinfo
**/*.tsbuildinfo

# ---- Logs ----
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# ---- Coverage / test output ----
coverage/
**/coverage/

# ---- Editor / OS ----
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# ---- Misc ----
*.local
.cache/